{
  "name": "synapse-remake",
  "productName": "Synapse Remake",
  "version": "0.1.0",
  "description": "本地学术文献管理 + PDF 阅读标注（智慧水务课程科研工具）",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "install-electron && node scripts/sqlite-abi.mjs setup",
    "dev": "node scripts/sqlite-abi.mjs use electron && electron-vite dev",
    "build": "node scripts/sqlite-abi.mjs use electron && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "node scripts/sqlite-abi.mjs use node && vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run quality:check && npm run tickets:check && npm run locks:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "quality:check": "node scripts/check-quality.mjs",
    "tickets:check": "node scripts/check-tickets.mjs",
    "locks:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lock-protected.ps1 -GenerateOnly",
    "locks:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/lock-protected.ps1",
    "locks:check": "node scripts/check-locks.mjs",
    "locks:unlock": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unlock-protected.ps1",
    "ticket:new": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/new-ticket.ps1"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "electron": "42.9.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.1.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.21.5": true
  }
}
