+    const { s, a, b } = seedRefNodes()
+    const e1 = svc.upsertEdge({ fromNode: s, toNode: a, label: '', kind: 'ref' })
+    expect(e1.kind).toBe('ref')
+    const e2 = svc.upsertEdge({ fromNode: s, toNode: b, label: '', kind: 'ref' })
+    expect(e2.kind).toBe('ref')
