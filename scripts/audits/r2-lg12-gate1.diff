+    )
+    const t = repo.upsertNode({ paperId: null, title: '阶段综述', coreIdea: '', year: 2020, x: null, y: null })
+    expect(() => svc.upsertEdge({ fromNode: t.id, toNode: a, label: '', kind: 'ref' })).toThrow(
+      '参考边只能由综述节点发出'
