+    expect(overflowState.root, 'INV-01: #root 必须 overflow:hidden').toBe('hidden')
+
+    // ── 二、键位滚动步（F-03 语义回归）：PageDown → scrollTop 前进 ≈0.9 视口高，
+    // 不越一屏；页码回写防抖——窗内页指示不翻 ──
+    const top0 = await scrollTop()
