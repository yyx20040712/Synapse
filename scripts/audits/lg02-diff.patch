+  function place(id: string): Frame {
+    const kids = children.get(id) ?? []
+    if (kids.length === 0) {
+      selfRel.set(id, NODE_W / 2)
+      return { left: [0], right: [NODE_W], width: NODE_W }
+    }
+    const mergedL: number[] = []
+    const mergedR: number[] = []
+    const offsets: number[] = []
