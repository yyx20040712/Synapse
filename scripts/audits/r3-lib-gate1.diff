/* ══ R3-U2 文献库皮肤（shell-library.html .list/.card/.filterbar/.chip 段誊录）══
   卡片网格+渐变材质+L 角饰+菱形分隔+筛选 chips；token 全走 theme.css :root 单源
   （禁散落硬编码色值）。由 LibraryPage.tsx import（feature 树唯一挂载点）。 */

/* 文献卡网格：auto-fill 自适应列（窄窗单列、宽窗多列） */
.lib-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 12px;
  align-content: start;
}
.lib-card {
  position: relative;
  display: block;
  width: 100%;
  font: inherit;
  text-align: left;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius-l);
  /* 渐变+inset 顶高光（mockup .card 材质三件套之二）；背景裁到 padding-box——
     渐变端点与 border 交界处亚像素缝隙锁（设计定稿注意事项②） */
  background: linear-gradient(168deg, #fffdf9 0%, var(--panel) 40%, #fdfaf3 100%);
  background-clip: padding-box;
  box-shadow: var(--shadow-1), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  cursor: pointer;
  transition: box-shadow 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
}
.lib-card:hover {
  box-shadow: var(--shadow-2);
  border-color: var(--border-gold);
  transform: translateY(-1px);
}
.lib-card:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}
/* 选中卡：accent 浅底+描边（渐变材质让位，保持选中态唯一性） */
.lib-card-selected {
  border-color: var(--accent);
  background: var(--accent-soft);
  background-clip: padding-box;
  box-shadow: inset 0 0 0 1px var(--accent);
}
/* L 形金角饰（hover 显形——mockup 伪元素改实 span：jsdom 可断言） */
.lib-corner {
  position: absolute;
  width: 14px;
  height: 14px;
  border: 1px solid transparent;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
}
.lib-corner-tl {
  top: -1px;
  left: -1px;
  border-right: 0;
  border-bottom: 0;
  border-radius: var(--radius-l) 0 0 0;
}
.lib-corner-br {
  bottom: -1px;
  right: -1px;
  border-left: 0;
  border-top: 0;
  border-radius: 0 0 var(--radius-l) 0;
}
.lib-card:hover .lib-corner {
  opacity: 0.9;
  border-color: var(--gold);
}
/* 卡内排版：衬线年份+两行截断题名+斜体 venue+6px 胶囊标签+tabular-nums meta */
.lib-card-row1 {
  display: flex;
  align-items: baseline;
  gap: 10px;
}
.lib-card-year {
  flex: none;
  min-width: 44px;
  font-family: var(--font-display);
  font-size: 17px;
  color: var(--gold);
}
.lib-card-title {
  min-height: 38px;
  font-size: 13.5px;
  line-height: 1.45;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.lib-card-venue {
  display: block;
  margin-top: 6px;
  font-size: 11.5px;
  color: var(--text-dim);
  font-style: italic;
}
.lib-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 9px;
}
.lib-tag {
  font-size: 10.5px;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 6px;
  padding: 1px 9px;
}
.lib-card-tagmore {
  align-self: center;
  font-size: 10.5px;
  color: var(--text-dim);
}
.lib-card-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 9px;
  font-size: 11px;
  color: var(--text-dim);
  font-variant-numeric: tabular-nums;
}
/* 筛选 chips：搜索框/下拉统一胶囊语法（mockup .chip/.search） */
.lib-chip {
  font-size: 12px;
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 4px 12px;
  background: var(--panel-glass);
  box-shadow: var(--shadow-1);
}
.lib-chip:focus-visible {
  outline: 1px solid var(--accent);
}
/* 菱形分隔线（渐隐线+◆+渐隐线）；线段 min-width 24px+flex:1——窄窗防碰撞
   （设计定稿注意事项③：窗口收窄时线先收、◆永不与内容挤压） */
.lib-rule {
  display: flex;
  align-items: center;
  gap: 10px;
}
.lib-rule-line {
  flex: 1;
  min-width: 24px;
