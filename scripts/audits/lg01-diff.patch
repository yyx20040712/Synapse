+  svc.upsertEdge({ fromNode: a, toNode: b, label: '' })
+  svc.upsertEdge({ fromNode: b, toNode: c, label: '' })
+  expect(() => svc.upsertEdge({ fromNode: c, toNode: a, label: '回边' })).toThrow('环')
+  expect(svc.graph().edges).toHaveLength(2)
