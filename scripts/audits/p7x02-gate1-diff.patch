+    expect(ls.getItem(OUTBOX_ENTRY_KEY_PREFIX + 'bad')).toBeNull()
+    expect(ls.getItem(OUTBOX_ENTRY_KEY_PREFIX + 'shapewrong')).toBeNull()
+    expect(corrupt).toHaveLength(2)
+  })
+})
