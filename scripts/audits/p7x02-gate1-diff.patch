+      )
+      let out = ''
+      child.stdout.on('data', (d) => {
+        out += String(d)
+      })
+      child.on('exit', (code) => {
+        if (code === 0) {
+          resolve(JSON.parse(out) as { s: number; p: number })
+        } else {
+          reject(new Error(`读库子进程退出码 ${code ?? 'null'}`))
+        }
+      })
+      child.on('error', reject)
+    })
+  } finally {
+    await writeFile(releaseBinding, electronBinding)
+  }
+}
